# Cloudflare Pages Custom Headers
# https://developers.cloudflare.com/pages/configuration/headers/

/
  Cache-Control: no-store

/borrow
  Cache-Control: no-store

/borrow*
  Cache-Control: no-store

/tracking
  Cache-Control: no-store

/tracking*
  Cache-Control: no-store

/history
  Cache-Control: no-store

/history*
  Cache-Control: no-store

/success
  Cache-Control: no-store

/success*
  Cache-Control: no-store

/*.html
  Cache-Control: no-store

/admin/*.html
  Cache-Control: no-store

/admin/*
  # Security Headers for Admin Panel
  Content-Security-Policy: default-src 'self'; script-src 'self'; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://simset-showroom-proxy.simset-admin.workers.dev wss://simset-showroom-proxy.simset-admin.workers.dev; style-src 'self' https://fonts.googleapis.com 'unsafe-inline'; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; frame-ancestors 'none'; form-action 'self'; base-uri 'self';
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

/*
  # Basic Security Headers for Public Site
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
